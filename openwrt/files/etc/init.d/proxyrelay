#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/proxyrelay
CONF=/etc/config/proxyrelay

start_service() {
	local enabled db_path web_port password ui_dir tproxy_enabled tproxy_port

	config_load proxyrelay
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get_bool tproxy_enabled global tproxy_enabled 0
	config_get tproxy_port global tproxy_port "12345"
	config_get db_path global db_path "/etc/proxyrelay/proxy.db"
	config_get web_port global web_port "8080"
	config_get password global password ""
	config_get ui_dir global ui_dir "/usr/share/proxyrelay/ui"

	mkdir -p "$(dirname "$db_path")"
	mkdir -p /var/log/proxyrelay /usr/share/proxyrelay /etc/proxyrelay

	# 清理可能残留的孤儿 mihomo 进程
	killall -9 mihomo 2>/dev/null || true

	procd_open_instance
	if [ -n "$password" ]; then
		procd_set_param command "$PROG" -d "$db_path" -w "$web_port" -p "$password" -u "$ui_dir"
	else
		procd_set_param command "$PROG" -d "$db_path" -w "$web_port" -u "$ui_dir"
	fi
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# 防火墙透明重定向规则联动
	if [ -x /usr/share/proxyrelay/firewall.include ]; then
		sh /usr/share/proxyrelay/firewall.include reload >/dev/null 2>&1 &
	fi
}

stop_service() {
	if [ -x /usr/share/proxyrelay/firewall.include ]; then
		sh /usr/share/proxyrelay/firewall.include stop >/dev/null 2>&1 || true
	fi
	killall -9 mihomo 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger "proxyrelay"
}
